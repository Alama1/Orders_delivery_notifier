# ─── Google Sheets ────────────────────────────────────────────────
# ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Service-account key: EITHER a path to the JSON file (local/VM setups)…
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
# …OR the key itself for Portainer/docker deployments — the JSON content or
# its base64 (base64 -w0 credentials/service-account.json). Takes priority.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Tab that holds the orders. Leave empty to use the FIRST (leftmost) tab.
ORDERS_TAB=
# Tab that holds the notification settings
SETTINGS_TAB=Налаштування

# ─── Telegram ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Primary chat — auto-registered as the first recipient on boot.
# More people add themselves by sending /add to the bot.
TELEGRAM_CHAT_ID=

# ─── PostgreSQL (dedup state) ─────────────────────────────────────
# The app auto-creates the DB_NAME database on first start.
DATABASE_URL=postgres://alamai:CHANGE_ME@db.alamai.dev:5432/postgres
DB_NAME=order_delivery
# auto (default) = SSL for non-local hosts; set to `disable` if the server has no SSL
DATABASE_SSL=auto

# ─── Scheduler ────────────────────────────────────────────────────
CRON=*/10 * * * *
TIMEZONE=Europe/Kyiv

# ─── Fallback notification settings ───────────────────────────────
# Used when the settings tab is missing or invalid
NOTIFY_TIME=09:00
NOTIFY_DAYS=3
# Work-hours window end (HH:MM); empty = no upper bound
NOTIFY_END_TIME=
# 1 = also send on Saturdays/Sundays
NOTIFY_WEEKENDS=0

# ─── Channels ─────────────────────────────────────────────────────
# Currently implemented: telegram. (whatsapp, viber — planned)
NOTIFY_CHANNELS=telegram

# ─── Testing ──────────────────────────────────────────────────────
# 1 = do not send anything and do not write to the DB, just log what would happen
DRY_RUN=0
